# ───────────────────────────────────────────────
# فومنت (Fuwment) — سیستم مولتی‌ایجنت تولید محتوا
# این فایل را به .env.local کپی کنید و مقادیر را پر کنید.
# ───────────────────────────────────────────────

# ── مدل زبانی (اجباری) ──────────────────────────────────────
# همه‌ی ایجنت‌ها از طریق OpenRouter کار می‌کنند (یک کلید برای همه‌ی مدل‌ها).
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# مدل پیش‌فرض همه‌ی ایجنت‌ها (slug از openrouter.ai/models)
PIPELINE_MODEL=google/gemini-2.5-flash
# اختیاری: مدل قوی‌تر فقط برای ایجنت «نویسنده» (اگر خالی باشد از PIPELINE_MODEL استفاده می‌شود)
# WRITER_MODEL=anthropic/claude-sonnet-4.5

# ── آدرس پایه‌ی سایت (برای دیپلوی اجباری) ───────────────────
# در لینک‌های canonical و JSON-LD مصرف می‌شود.
# اگر تنظیم نشود مقدار پیش‌فرض http://localhost:3000 است — یعنی سایت
# پروداکشن، canonical و structured data را به localhost اشاره می‌دهد و
# گوگل صفحه‌ها را درست ایندکس نمی‌کند. بدون خطا و بی‌صدا خراب می‌شود.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── جستجوی وب برای ایجنت پژوهشگر (اختیاری) ─────────────────
# اگر کلید Tavily بدهید، پژوهشگر واقعاً وب را جستجو می‌کند؛
# در غیر این صورت به دانش خود مدل تکیه می‌کند (پایپ‌لاین همچنان کار می‌کند).
# کلید رایگان: https://tavily.com
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ── انتقال به وردپرس (اختیاری) ──────────────────────────────
# بلاگ عمومی روی وردپرس است و این پروژه فقط تولیدکننده‌ی محتواست.
# با این متغیرها، مقاله‌ی تأییدشده خودکار به‌عنوان «پیش‌نویس» در وردپرس
# ساخته می‌شود. بدون آن‌ها این مرحله بی‌صدا رد می‌شود و پایپ‌لاین
# همچنان کار می‌کند (مثل Tavily).
#
# رمز را از پیشخوان وردپرس بسازید:
#   Users → Profile → Application Passwords
# رمز با فاصله نمایش داده می‌شود؛ همان‌طور که هست کپی کنید — هر دو شکل
# (با و بدون فاصله) کار می‌کند.
#
# ⚠️ پست‌ها همیشه «پیش‌نویس» ساخته می‌شوند، هرگز منتشرشده. انتشار نهایی
#    تصمیم انسان است و در خود وردپرس انجام می‌شود.
# WORDPRESS_URL=https://fa.fuwment.com
# WORDPRESS_USER=نام-کاربری-وردپرس
# WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
#
# اختیاری — شناسه‌ی دسته. بدون آن، همه‌ی پست‌ها در Uncategorized می‌افتند.
# شناسه را از /wp-json/wp/v2/categories یا آدرس صفحه‌ی ویرایش دسته بگیرید.
#
# ⚠️ شناسه‌ی دسته مخصوصِ همان نصب وردپرس است و بین سایت‌ها منتقل نمی‌شود.
#    اگر WORDPRESS_URL را عوض کردید، این عدد را هم دوباره از همان سایت
#    بگیرید — عددِ کهنه یعنی وردپرس درخواست را با rest_invalid_param رد
#    می‌کند و هیچ پیش‌نویسی ساخته نمی‌شود.
#    روی fa.fuwment.com: ۹ = دیدگاه‌های تخصصی
# WORDPRESS_CATEGORY_ID=9

# ── ذخیره‌سازی (اختیاری برای اجرای محلی) ────────────────────
# بدون Supabase سیستم در «حالت حافظه» اجرا می‌شود (داده‌ها با ری‌استارت پاک می‌شوند).
# برای دیپلوی روی Vercel، تنظیم Supabase اجباری است.
# اسکیمای جدول‌ها: supabase/schema.sql
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── امنیت استودیو (برای دیپلوی عمومی توصیه می‌شود) ──────────
# اگر تنظیم شود، صفحه‌ی /studio و APIهای مدیریتی رمز می‌خواهند.
# STUDIO_PASSWORD=یک-رمز-قوی

# ── اجرای خودکار هفتگی (کرون Vercel) ────────────────────────
# با این دستور بسازید: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=یک-رشته-تصادفی
